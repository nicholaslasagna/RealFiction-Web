NEXT_PUBLIC_SITE_URL=https://realfiction.live
NEXT_PUBLIC_MINECRAFT_SERVER=realfiction.live
NEXT_PUBLIC_BEDROCK_SERVER=bedrock.realfiction.live

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public, build-time). The matching secret is set
# in the Supabase dashboard (Authentication > Bot & Abuse Protection), not here.
# Leave blank only in local development. Production needs a real site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Payments — see docs/PAYMENTS_GO_LIVE.md for the full test -> live runbook.
# Card / Apple Pay / Google Pay all go through Stripe Checkout.
STRIPE_SECRET_KEY=          # sk_test_… in test, sk_live_… in production
STRIPE_WEBHOOK_SECRET=      # signing secret of the /api/webhooks/stripe endpoint

# "sandbox" (test) or "production" (live; "live" is also accepted).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=         # Webhook ID of the /api/webhooks/paypal endpoint

VOTE_WEBHOOK_SECRET=
REALCORE_PLUGIN_SECRET=

# Optional service-token path for approved staff economy migration imports.
# Leave blank unless running a reviewed import/rollback script.
ECONOMY_IMPORT_SERVICE_SECRET=

# Set to "true" only for staging/bootstrap to allow shared-secret plugin auth.
# Leave unset in production so RealCore must use HMAC signing.
REALCORE_ALLOW_SHARED_SECRET=

# Optional: post each contact-form submission to a private Discord channel.
# Create a channel webhook (Server Settings → Integrations → Webhooks → New
# Webhook → Copy Webhook URL) and paste it here. Leave blank to disable —
# submissions are always saved to the support_tickets table regardless.
DISCORD_CONTACT_WEBHOOK_URL=

# Transactional email (Resend). Without RESEND_API_KEY, queued confirmations park
# as `unconfigured` WITHOUT consuming their retry budget and send once the key is
# added — nothing is lost, and checkout/fulfilment are unaffected either way.
# Runtime secret only, never a Build variable. The sending domain needs SPF +
# DKIM records on realfiction.live.
RESEND_API_KEY=
EMAIL_FROM="RealFiction <orders@realfiction.live>"
EMAIL_SUPPORT_ADDRESS=support@realfiction.live

# Abuse-control subject pepper.
#
# WHAT IT IS FOR
# A server-held secret used to hash the IP addresses and email addresses that
# the gift-card velocity controls count against. Those hashes are the ONLY form
# in which either value is stored; the raw values never reach the database.
#
# WHY IT IS NOT OPTIONAL IN PRACTICE
# An IPv4 space is 2^32, so an UNPEPPERED hash of an address is reversible in
# seconds and is therefore the address. With the pepper, the abuse table on its
# own — leaked, subpoenaed, or restored from a backup — yields nothing.
#
# MANDATORY, AND FAIL-CLOSED. Without it there is no per-IP, per-email, or
# per-recipient counting — only per-account, which an attacker defeats by
# making accounts. So gift-card checkout, claim, refund, and cash-redemption
# all refuse outright, and the storefront gate keeps gift cards in Coming Soon
# rather than showing a buy button that could never succeed. There is no
# raw-value fallback and no degraded mode.
#
# Any long random string (e.g. `openssl rand -hex 32`). Runtime secret only,
# never a Build variable.
#
# DO NOT ROTATE CASUALLY: rotating it resets every hashed counter, which is a
# deliberate operational act, not maintenance.
#
# RETENTION of what it protects (purge_abuse_events, on the existing Cron):
#   IP hashes                        7 days
#   account / email / recipient     45 days
# These rows exist only to decide whether to allow, review, or refuse a
# gift-card action. They are not analytics and nothing else reads them.
ABUSE_SUBJECT_PEPPER=

# ---------------------------------------------------------------------------
# Gift cards
# ---------------------------------------------------------------------------
# ALL of these must be present as WORKER RUNTIME values before the storefront
# will offer a gift card. `evaluateGiftCardAvailability` checks every one of
# them on each request; a missing value renders the Coming Soon card instead of
# a purchase form. They are NOT build variables — see docs below.
#
# Placeholders only. Never commit a real value.

# The master switch. Anything other than the exact string "true" keeps gift
# cards off. Not a NEXT_PUBLIC_ value, so it is read at request time and a
# change takes effect on the next Worker version — no rebuild required.
STORE_GIFT_CARDS_ENABLED=false

# The owner's REVIEWED tax decision. There is no default and no boolean,
# because the correct answer cannot be determined from this repository:
# ordinary checkout builds inline `price_data` and never references a Stripe
# Price, so the tax category on the Dashboard Product is not what Stripe charges
# against.
#
#   no_tax_at_sale  stored value is not taxed at sale; tax applies when the
#                   credit is spent. Requires confirming Stripe Tax is not
#                   configured to tax this session.
#   tax_at_sale     NOT implementable without a Dashboard tax-code decision, so
#                   it deliberately fails closed.
#
# Leave blank until an accountant has answered. This is a launch blocker on
# purpose.
GIFT_CARD_TAX_TREATMENT_REVIEWED=

# HMAC pepper for gift-card claim credentials. 32 bytes, as 64 hex characters
# or base64url. Generate with: openssl rand -hex 32
#
# ROTATING THIS INVALIDATES EVERY UNCLAIMED CARD — the verifier stored for each
# credential is derived from it, so a rotation makes every outstanding claim
# link permanently unredeemable. Treat it as write-once.
GIFT_CARD_CLAIM_PEPPER=

# AES-256-GCM key sealing the delivery secret in each credential row. 32 bytes,
# same format. Generate SEPARATELY from the pepper — never reuse one value for
# both, or a single leak compromises both the verifier and the sealed secret.
# Generate with: openssl rand -hex 32
GIFT_CARD_ENCRYPTION_KEY=

# Which key version new cards are sealed under. OPTIONAL — defaults to 1, so
# nothing needs setting before the first card is issued. Set it only when
# rotating GIFT_CARD_ENCRYPTION_KEY, and only to a positive integer; a typo like
# "1.5" or "2abc" fails configuration rather than silently sealing under the
# wrong key.
GIFT_CARD_ENCRYPTION_KEY_VERSION=1

# ABUSE_SUBJECT_PEPPER is required for gift cards too, and is documented above
# with the other abuse-control settings.

# ---------------------------------------------------------------------------
# Discord announcements (OPTIONAL — the page degrades gracefully without these)
# ---------------------------------------------------------------------------
# Member counts on the homepage and /discord need NO credentials: Discord's
# invite endpoint serves approximate counts anonymously.
#
# Reading the latest ANNOUNCEMENT is different — there is no anonymous way to
# read messages. It needs a bot that is a member of the guild with `View
# Channel` + `Read Message History` on the announcements channel.
#
# A WEBHOOK IS NOT A SUBSTITUTE. DISCORD_CONTACT_WEBHOOK_URL above is
# write-only; Discord offers no way to read a channel through one.
#
# Runtime SECRET, never a build variable and never a plaintext var.
DISCORD_BOT_TOKEN=

# The announcements channel's numeric id (Developer Mode -> right-click -> Copy
# Channel ID). Validated as a snowflake before any request is made.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
